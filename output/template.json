{
	"$schema" : "http://json-schema.org/draft-07/schema#",
	"properties" : {
		"logging" : {
			"$ref" : "#/$defs/logging",
			"description" : "logging"
		},
		"template" : {
			"$ref" : "#/$defs/template",
			"description" : "template"
		}
	},
	"required" : ["template"],
	"additionalProperties" : false,
	"$defs" : {
		"logging" : {
			"properties" : {
				"logfile" : {
					"type" : "string"
				},
				"loglevel" : {
					"type" : "integer",
					"minimum" : 0,
					"maximum" : 6
				}
			},
			"required" : [],
			"additionalProperties" : false
		}, 
		"template" : {
			"properties" : {
				"engine" : {
					"type" : "string"
				},
				"outputDirectory" : {
					"type" : "string"
				}
			},
			"required" : ["engine"],
			"additionalProperties" : false
		}
	}
}
